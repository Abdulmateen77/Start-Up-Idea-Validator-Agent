# Copy to .env and fill in. Never commit the real .env.
# Placeholders only — no real values in this file, it IS committed.
# See CLAUDE.md "Tech Stack" for why these were chosen.

# LLM provider key (the default provider is Anthropic / Claude).
ANTHROPIC_API_KEY=
FIRECRAWL_API_KEY=

# Optional — model-agnostic LLM layer (graph/llm.py). All have sensible defaults.
# LLM_PROVIDER=anthropic        # which provider answers; see graph/providers/
# LLM_MODEL=claude-opus-5-5     # omit to use the provider's default model
# LLM_MAX_TOKENS=16000          # output ceiling per call
